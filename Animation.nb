   RowBox[{"{", 
    RowBox[{
     RowBox[{"NotebookDirectory", "[", "]"}], 
     ",", "\"\<TwoHedgehogs.wl\>\""}], "}"}], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Needs", "[", "\"\<TwoHedgehogs`\>\"", "]"}]}], "Input",
 CellChangeTimes->{{3.993616640594215*^9, 3.993616640596694*^9}, {
   3.99361674447921*^9, 3.993616747085436*^9}, {3.993616784344891*^9, 
   3.99361684770499*^9}, {3.9936186897527227`*^9, 3.993618697401616*^9}, 
   3.993618768302948*^9, {3.993623508961275*^9, 3.9936235212417183`*^9}, {
   3.993623611978422*^9, 3.993623625298607*^9}, {3.99362372498641*^9, 
   3.9936237272993097`*^9}},
 CellLabel->
  "In[118]:=",ExpressionUUID->"2ae3a7e5-7b37-405a-af01-54d37c3c3e22"],

Cell[CellGroupData[{

Cell[BoxData["hedgehogAnimation"], "Input",
 CellChangeTimes->{{3.993617190736999*^9, 3.9936171907395973`*^9}, {
  3.993617829806828*^9, 3.99361783052632*^9}, {3.993623825993848*^9, 
