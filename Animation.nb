Notebook[{

Cell[CellGroupData[{
Cell["Parameterizing 2-hedgehogs: an interactive visualization", "Title",
 CellChangeTimes->{{3.9936119815349207`*^9, 3.993612010000636*^9}, {
  3.993618444225569*^9, 
  3.99361844637584*^9}},ExpressionUUID->"752cb76a-3cc2-4795-bcac-\
8834f53de491"],

Cell["\<\
In this notebook, we produce an animation to visualize how the Riemann map \
parameterizes 2-hedgehogs of fixed angles and unit transfinite diameter. \
\>", "Subtitle",
 CellChangeTimes->{{3.9936120261239367`*^9, 
  3.9936120855299263`*^9}},ExpressionUUID->"f09277f1-65e1-49f5-9d5d-\
542fb380c032"],

Cell[TextData[{
 "The complex numbers ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["z", "1"], ",", "...", ",", 
   SubscriptBox["z", "n"]}]], "InlineCode",ExpressionUUID->
  "5f85d248-8e86-408a-8227-b680614348b8"],
 " generate the ",
 StyleBox["hedgehog ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{"H", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["z", "1"], ",", "...", ",", 
      SubscriptBox["z", "n"]}], ")"}]}], "=", 
   RowBox[{
    SubscriptBox["\[Union]", 
     RowBox[{"i", "\[Element]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "...", ",", "n"}], "}"}]}]], 
    RowBox[{"[", 
     RowBox[{"0", ",", 
      SubscriptBox["z", "i"]}], "]"}]}]}]], "InlineCode",ExpressionUUID->
  "7f64785a-c6a2-4ccc-94a3-31142f40355b"],
 " where ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"[", 
    RowBox[{"0", ",", 
     SubscriptBox["z", "i"]}], "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"t", " ", 
     RowBox[{
      SubscriptBox["z", "i"], " ", ":", " ", 
      RowBox[{"0", "\[LessEqual]", "t", "\[LessEqual]", "1"}]}]}], "}"}]}]], 
  "InlineCode",ExpressionUUID->"94592d96-ac07-4006-9638-51e07ff833d2"],
 ".\nSuppose that ",
 Cell[BoxData[
  RowBox[{"n", "=", "2"}]], "InlineCode",ExpressionUUID->
  "6441d3b4-59be-4dd5-a33b-37a4b3fd58e5"],
 ". Up to rotation, we can assume that ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["z", "1"], "=", 
   SubscriptBox["z", "r"]}]], "InlineCode",ExpressionUUID->
  "196a6913-1851-4ab3-a497-78795cae6930"],
 " is a real number and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["z", "2"], "=", 
   SubscriptBox["z", "c"]}]], "InlineCode",ExpressionUUID->
  "01789950-9b49-4fcd-b3b9-d46d663bc755"],
 " is a complex number with positive imaginary part.  Assume that ",
 Cell[BoxData[
  RowBox[{"H", "=", 
   RowBox[{"H", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["z", "r"], ",", "z_c"}]}]}]}]], "InlineCode",
  ExpressionUUID->"4ead8874-9187-495b-a099-2f5b9927f1fa"],
 ") has transfinite diameter 1 and denote the counterclockwise angle from ",
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"0", ",", 
    SubscriptBox["z", "r"]}], "]"}]], "InlineCode",ExpressionUUID->
  "5414d677-cd75-4b71-a82a-3bdb90aacb95"],
 "to",
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"0", ",", 
    SubscriptBox["z", "c"]}], "]"}]], "InlineCode",ExpressionUUID->
  "a6ed2bc2-8bb9-40e9-bf6b-b9ae5d105294"],
 "by ",
 Cell[BoxData[
 "\[Theta]"], "InlineCode",ExpressionUUID->
  "089f45ba-d366-41f6-adcd-36e73f3ef927"],
 ". After a computation due to Harry Schmidt, the Riemann parameterization in \
this case can be written as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[CapitalPsi]", 
    RowBox[{"(", "t", ")"}]}], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     FractionBox["p", "2"]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", 
       SuperscriptBox["e", 
        RowBox[{"-", "is"}]]}], ")"}], 
     RowBox[{
      FractionBox["p", "2"], "-", "1"}]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["e", "it"], "-", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["e", 
          RowBox[{"-", "it"}]], "-", "1"}], ")"}]}], ")"}], 
     FractionBox["p", "2"]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["e", "it"], "-", 
         SuperscriptBox["e", "is"]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["e", 
          RowBox[{"-", "it"}]], "-", 
         SuperscriptBox["e", 
          RowBox[{"-", "is"}]]}], ")"}]}], ")"}], 
     RowBox[{"1", "-", 
      FractionBox["p", "2"]}]]}]}]], "InlineCode",ExpressionUUID->
  "c3df06ef-6142-402f-b8d0-0fae8e014078"],
 ", where ",
 Cell[BoxData[
  RowBox[{"s", "\[Element]", 
   RowBox[{"(", 
    RowBox[{"0", ",", "\[Pi]"}], ")"}]}]], "InlineCode",ExpressionUUID->
  "d41ea3a1-588e-44c2-8702-bd0f6d8ed666"],
 "is a parameter determining H and ",
 Cell[BoxData[
  RowBox[{"p", "=", 
   RowBox[{"\[Theta]", "/", "\[Pi]"}]}]], "InlineCode",ExpressionUUID->
  "086e6ffb-99a5-4e9c-98be-64d4b22a8f24"],
 "."
}], "Text",
 CellChangeTimes->{{3.993612110471117*^9, 3.9936123076664124`*^9}, {
   3.9936123603349733`*^9, 3.9936124089572773`*^9}, {3.993612497688925*^9, 
   3.993612511878985*^9}, {3.9936125469361763`*^9, 3.993612897157045*^9}, {
   3.993612931422237*^9, 3.993612934705881*^9}, {3.993613029650476*^9, 
   3.993613067619616*^9}, {3.993613150017619*^9, 3.993613475773654*^9}, 
   3.993616608187008*^9},ExpressionUUID->"c5317d6d-876c-4db6-aa7e-\
72cc380745b6"],

Cell[TextData[{
 "We are interested in the absolute value ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"f", 
    RowBox[{"(", "t", ")"}]}], "=", 
   RowBox[{
    RowBox[{"|", 
     RowBox[{"\[CapitalPsi]", 
      RowBox[{"(", "t", ")"}]}], "|"}], "=", 
    RowBox[{"2", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"cos", "[", "t", "]"}]}], ")"}], 
      FractionBox["p", "2"]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"cos", "[", 
         RowBox[{"t", "-", "s"}], "]"}]}], ")"}], 
      RowBox[{"1", "-", 
       FractionBox["p", "2"]}]]}]}]}]], "InlineCode",ExpressionUUID->
  "d8c372a6-8a5d-4ee2-b203-b97c94030548"],
 ".\nWe proved that ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"|", 
    SubscriptBox["z", "r"], "|"}], "=", 
   RowBox[{"f", 
    RowBox[{"(", 
     SubscriptBox["t", "r"], ")"}]}]}]], "InlineCode",ExpressionUUID->
  "6dd32d67-b20f-44bc-924e-1149edb5268f"],
 "  and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"|", 
    SubscriptBox["z", "c"], "|"}], "=", 
   RowBox[{"f", 
    RowBox[{"(", 
     SubscriptBox["t", "c"], ")"}]}]}]], "InlineCode",ExpressionUUID->
  "c441ee54-2d6d-4265-94c1-6153b5a3f07a"],
 "where  ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["t", "r"], "=", 
   RowBox[{
    FractionBox["s", "2"], "+", 
    RowBox[{"ArcSin", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", "-", "1"}], ")"}], 
      RowBox[{"Sin", "[", 
       FractionBox["s", "2"], "]"}]}], "]"}]}]}]], "InlineCode",
  ExpressionUUID->"26fe5018-a55d-4344-9efd-75a9dd60be5e"],
 "and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["t", "c"], "=", 
   RowBox[{
    FractionBox["s", "2"], "+", "\[Pi]", "-", 
    RowBox[{"ArcSin", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", "-", "1"}], ")"}], 
      RowBox[{"Sin", "[", 
       FractionBox["s", "2"], "]"}]}], "]"}]}]}]], "InlineCode",
  ExpressionUUID->"6039ec58-594b-4619-9aa6-b67cf4ac0c60"],
 ".\nTo keep the code more readable, we will call ",
 Cell[BoxData[
 "uniformizationValue"], "InlineCode",ExpressionUUID->
  "e9f397d1-657b-4759-a3c1-3e4dab844a67"],
 " the map ",
 Cell[BoxData[
 "f"], "InlineCode",ExpressionUUID->"a1c22253-bf6c-424e-b307-f4c2725a7f2d"],
 "; define ",
 Cell[BoxData[
  RowBox[{"Angle", "[", 
   RowBox[{"s", ",", "p"}], "]"}]], "InlineCode",ExpressionUUID->
  "110ad955-08c3-4cf8-825c-e07475504f47"],
 " the arcsine summand in the expression for ",
 Cell[BoxData[
 "f"], "InlineCode",ExpressionUUID->"cc49875c-299e-4432-968c-7b37f130b65d"],
 ";"
}], "Text",
 CellChangeTimes->{{3.9936166255296297`*^9, 3.993616653668009*^9}, 
   3.993623650558996*^9},ExpressionUUID->"892512b4-6aeb-4f4e-a9c4-\
b63d7be66550"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.993616990044483*^9, 3.993616994930545*^9}},
 CellLabel->
  "In[117]:=",ExpressionUUID->"55dcede0-f178-4551-ae46-9195ed53679a"],

